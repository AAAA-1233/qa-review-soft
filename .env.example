APP_PORT=8080

POSTGRES_DB=qa_review
POSTGRES_USER=qa_review
POSTGRES_PASSWORD=change-this-password

CORS_ORIGINS=http://localhost:8080,https://your-domain.example
ALLOW_SERVER_PATH_IMPORT=false
SEED_SAMPLE_DATA=false

# 账号密码登录
# 生产环境必须改成一段随机长字符串，例如 32 位以上。
AUTH_SECRET=change-this-long-random-secret
AUTH_TOKEN_EXPIRE_HOURS=168
